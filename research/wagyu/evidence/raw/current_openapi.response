{"openapi":"3.1.1","info":{"title":"Wagyu Consumer API","version":"v2","contact":{"name":"Wagyu API documentation","url":"https://docs.wagyu.xyz"},"description":"Public HTTP contract for building a Wagyu swap and native-bridge client. Order IDs are not credentials; retain the returned session ID privately. WebSocket updates are documented separately because REST remains the durable source of truth. An order status is final only when it is completed or refunded: failed and expired are not final, because a recovery or a late deposit can still complete or refund the order.","x-final-order-statuses":["completed","refunded"]},"components":{"securitySchemes":{"orderSession":{"type":"apiKey","in":"header","name":"x-session-id","description":"Owner credential returned when an order is created. Keep it private and send it only in this header, never in a URL."},"destinationProof":{"type":"apiKey","in":"query","name":"verify","description":"Read-only proof for one order: its exact destination address. Missing or invalid proof intentionally returns the same 404 as a missing order."},"integratorKey":{"type":"apiKey","in":"header","name":"x-integrator-key","description":"Optional integration credential. It does not unlock the API — quoting, creating and tracking all work without it. It attributes the order to your integration, collects your integrator fee, and is what permits a caller-supplied sessionId at creation. A confidential (server-side) key may also end the deposit wait of the orders created by its own integration. `x-api-key` is accepted as an alias; a key in the query string is refused even when valid, so a credential can never reach a proxy log. Sending no key is anonymous, never an error. A key that is present but invalid, revoked, or belongs to a suspended integration is refused with 401 on every route rather than silently downgraded to anonymous, and that 401 carries the generic unauthorized body — the reason stays in our logs."}},"schemas":{"AdsClickId":{"description":"Google Ads click identifier, when this order came from an ad. Stored apart from the order, used once to report the conversion, then deleted; it is never published back on any order read.","type":"object","properties":{"kind":{"type":"string","enum":["gclid","wbraid","gbraid"]},"value":{"type":"string","pattern":"^[A-Za-z0-9_-]{16,200}$"}},"required":["kind","value"],"additionalProperties":false},"ApiError":{"type":"object","properties":{"code":{"$ref":"#/components/schemas/ApiErrorCode"},"error":{"type":"string"},"minAmountUsd":{"type":"number","exclusiveMinimum":0},"retryAfter":{"type":"number","minimum":0}},"required":["code","error"],"additionalProperties":false},"ApiErrorCode":{"type":"string","enum":["invalid_request","unauthorized","forbidden","not_found","conflict","amount_below_minimum","no_route","paused","rate_limited","unavailable","request_failed"]},"AtomicAmount":{"type":"string","pattern":"^0*[1-9][0-9]*$","description":"Positive base-10 integer in the asset’s atomic unit."},"AtomicBalance":{"type":"string","pattern":"^0*[0-9]+$","description":"Non-negative base-10 integer in the asset’s atomic unit."},"BridgeAssetKey":{"type":"string","enum":["xmr","trx","zec"],"description":"Registered native-bridge asset key, never a display symbol."},"BridgeDirection":{"type":"string","enum":["deposit","withdraw"],"description":"deposit mints the wrapped asset from a native-coin deposit; withdraw returns the native coin against the wrapped asset."},"BridgeOrder":{"oneOf":[{"type":"object","properties":{"orderId":{"type":"string"},"product":{"type":"string","enum":["bridge"]},"status":{"$ref":"#/components/schemas/OrderStatus"},"asset":{"$ref":"#/components/schemas/BridgeAssetKey"},"direction":{"type":"string","enum":["deposit"]},"chainId":{"anyOf":[{"$ref":"#/components/schemas/ChainId"},{"type":"null"}]},"toAddress":{"type":["string","null"]},"createdAt":{"type":["string","null"]},"updatedAt":{"type":["string","null"]},"fromChainId":{"anyOf":[{"$ref":"#/compo